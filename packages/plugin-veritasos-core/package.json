{
  "name": "@dkg/plugin-veritasos-core",
  "version": "1.0.0",
  "description": "VeritasOS Core - Decentralized Reputation Engine for Trusted AI Agents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsup src/*.ts --format cjs,esm --dts --watch",
    "build": "tsup src/*.ts --format cjs,esm --dts",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "mocha --loader ../../node_modules/tsx/dist/loader.mjs 'tests/**/*.spec.ts'"
  },
  "keywords": [
    "reputation",
    "ai",
    "dkg",
    "origintrail",
    "trust",
    "sybil-resistance"
  ],
  "author": "VeritasOS Team",
  "license": "MIT",
  "devDependencies": {
    "@dkg/eslint-config": "*",
    "@dkg/typescript-config": "*",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "@dkg/plugin-dkg-essentials": "^0.0.3",
    "@dkg/plugin-swagger": "^0.0.2",
    "@dkg/plugins": "^0.0.2"
  }
}
